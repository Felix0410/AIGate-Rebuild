# Local-only Java properties compatible values: no surrounding quotes.
# Never commit .env. Generate separate random passwords for all accounts.
MYSQL_ROOT_PASSWORD=
AIGATE_DB_USERNAME=aigate_app
AIGATE_DB_PASSWORD=
AIGATE_FLYWAY_USERNAME=aigate_migrator
AIGATE_FLYWAY_PASSWORD=
# Optional when IDEA working directory is not the project root:
# AIGATE_ENV_FILE=/absolute/path/to/AIGateRe/.env

# Required: svc_ + 32 random bytes encoded as unpadded base64url.
# Inject the same service token into Gateway; Gateway must not load database credentials.
AIGATE_SERVICE_TOKEN=
# Required: independent 32+ random bytes encoded as standard base64; keep durable across restarts.
AIGATE_MANAGEMENT_PEPPER_KEY_ID=mgmt-v1
AIGATE_MANAGEMENT_PEPPER=
# Bootstrap is disabled during normal operation. INIT/RECOVERY require a strong bst_ token and CIDRs.
AIGATE_BOOTSTRAP_MODE=OFF
AIGATE_BOOTSTRAP_TOKEN=
AIGATE_BOOTSTRAP_ALLOWED_CIDRS=127.0.0.1/32,::1/128

# P2：两类运行Pepper独立，不能与管理用途或彼此复用。
AIGATE_AGENT_PEPPER_KEY_ID=agent-v1
AIGATE_AGENT_PEPPER=
AIGATE_EMPLOYEE_PEPPER_KEY_ID=employee-v1
AIGATE_EMPLOYEE_PEPPER=
# 可选历史材料须同时配置匹配版本和明确UTC截止时间：
# AIGATE_AGENT_PREVIOUS_PEPPER_KEY_ID=
# AIGATE_AGENT_PREVIOUS_PEPPER=
# AIGATE_AGENT_PREVIOUS_VALID_UNTIL=
# AIGATE_EMPLOYEE_PREVIOUS_PEPPER_KEY_ID=
# AIGATE_EMPLOYEE_PREVIOUS_PEPPER=
# AIGATE_EMPLOYEE_PREVIOUS_VALID_UNTIL=

# P3：AES-256主密钥与签发收据Pepper，必须分别生成且不能复用其它用途材料。
AIGATE_PROVIDER_ENCRYPTION_KEY_ID=provider-enc-v1
AIGATE_PROVIDER_ENCRYPTION_KEY=
AIGATE_PROVIDER_ISSUE_PEPPER_KEY_ID=provider-issue-v1
AIGATE_PROVIDER_ISSUE_PEPPER=
# 可选历史版本必须完整成对配置，保留供旧密文/永久收据追验。
# AIGATE_PROVIDER_PREVIOUS_ENCRYPTION_KEY_ID=
# AIGATE_PROVIDER_PREVIOUS_ENCRYPTION_KEY=
# AIGATE_PROVIDER_ISSUE_PREVIOUS_PEPPER_KEY_ID=
# AIGATE_PROVIDER_ISSUE_PREVIOUS_PEPPER=
# 可选受保护审批文件；为空时可登记DRAFT，但没有批准不能ACTIVE。
AIGATE_CATALOG_APPROVALS_FILE=
