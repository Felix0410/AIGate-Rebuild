# Local-only Java properties compatible values: no surrounding quotes.
# Never commit .env. Generate separate random passwords for all accounts.
MYSQL_ROOT_PASSWORD=
AIGATE_DB_USERNAME=aigate_app
AIGATE_DB_PASSWORD=
AIGATE_FLYWAY_USERNAME=aigate_migrator
AIGATE_FLYWAY_PASSWORD=
# Optional when IDEA working directory is not the project root:
# AIGATE_ENV_FILE=/absolute/path/to/AIGateRe/.env

# Required: svc_ + 32 random bytes encoded as unpadded base64url.
# Inject the same service token into Gateway; Gateway must not load database credentials.
AIGATE_SERVICE_TOKEN=
# Required: independent 32+ random bytes encoded as standard base64; keep durable across restarts.
AIGATE_MANAGEMENT_PEPPER_KEY_ID=mgmt-v1
AIGATE_MANAGEMENT_PEPPER=
# Bootstrap is disabled during normal operation. INIT/RECOVERY require a strong bst_ token and CIDRs.
AIGATE_BOOTSTRAP_MODE=OFF
AIGATE_BOOTSTRAP_TOKEN=
AIGATE_BOOTSTRAP_ALLOWED_CIDRS=127.0.0.1/32,::1/128
